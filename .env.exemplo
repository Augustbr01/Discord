# copie pra .env e preencha. Na VPS, o docker-compose.producao.yml lê este arquivo

# site (o endereço público, que o Caddy da VPS atende)
URL_SITE=https://liberdade.augustdev.com.br
MODO=production

# banco: na VPS, o host é o nome do container do Postgres na rede "web"
# (na sua máquina, rodando com npm/tsx, é localhost)
DATABASE_URL=postgres://usuario:senha@postgres:5432/liberdade

JWT_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

LIVEKIT_URL=wss://livekit.augustdev.com.br
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Cloudflare R2 (imagens)
R2_ACCOUNT_ID=
R2_ACESS_KEY=
R2_SECRET_ACESS_KEY=
R2_BUCKET=
R2_URL=
