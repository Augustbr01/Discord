# copie pra .env e preencha. Na VPS, o docker-compose.producao.yml lê este arquivo

# site (o endereço público, que o Caddy da VPS atende)
URL_SITE=https://liberdade.augustdev.com.br
MODO=production

# banco (o container db é criado com estes dados)
POSTGRES_USER=liberdade
POSTGRES_PASSWORD=
POSTGRES_DB=liberdade
# só pra rodar fora do docker (npm/tsx na sua máquina); no compose ele é montado a partir dos de cima
DATABASE_URL=postgres://liberdade:senha@localhost:5432/liberdade

JWT_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

LIVEKIT_URL=wss://livekit.augustdev.com.br
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Cloudflare R2 (imagens)
R2_ACCOUNT_ID=
R2_ACESS_KEY=
R2_SECRET_ACESS_KEY=
R2_BUCKET=
R2_URL=
